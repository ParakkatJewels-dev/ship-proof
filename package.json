{
  "name": "shipproof-root",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build:shared": "npm --prefix packages/shared run build",
    "build:api": "npm --prefix apps/api run build",
    "build:agent": "npm --prefix apps/camera-agent run build",
    "build:web": "npm --prefix apps/web run build",
    "build": "npm run build:shared && npm run build:api && npm run build:agent",
    "dev:api": "npm --prefix apps/api run dev",
    "dev:agent": "npm --prefix apps/camera-agent run dev",
    "dev:web": "npm --prefix apps/web run dev"
  }
}