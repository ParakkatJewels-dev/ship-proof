# Camera Station Agent Configuration
STATION_ID=11111111-1111-1111-1111-111111111111
STATION_API_KEY=station_key_hash_01
STATION_NAME="Packing Bay 1"

# Cloud Backend Connection
# ShipProof server(s), comma separated. With several (e.g. local test + live), the camera works on all of them
# and each video is uploaded to the server whose dashboard started the recording.
CLOUD_API_URL=http://localhost:4000
# CLOUD_API_URL=http://localhost:4000,https://your-api.vercel.app

# Local Zero-Latency Control Port
LOCAL_HTTP_PORT=7890

# Camera Device Configuration
# On Windows DirectShow: "video=Logitech HD Pro Webcam C920" or device index
CAMERA_DEVICE_INDEX=0
CAMERA_DEVICE_NAME="Integrated Camera"
# DVR / NVR / IP camera over RTSP (replaces the webcam when set). Keep the real address only in .env (never in Git).
# Hikvision DVR: channel N main stream = /Streaming/Channels/N01 (sub-stream N02). Use a DVR user with live view only.
# A password with @ : / # ? must be URL-encoded (@ -> %40).
# RTSP_STREAM_URL=rtsp://shipproof:PASSWORD@192.168.1.64:554/Streaming/Channels/101
# Seconds without video before the stream is dropped and reconnected (default 10).
# RTSP_TIMEOUT_SECONDS=10
# How often the stream is checked while idle, in seconds (default 30; failures back off up to 5 minutes).
# RTSP_CHECK_SECONDS=30

# Upload compression. With RTSP the defaults are CRF 23 and 3000 kbps (labels stay readable at 1080p);
# a webcam uses CRF 28 and 1000 kbps. The camera's own frame rate is kept, up to COMPRESS_FPS.
# COMPRESS_CRF=23
# COMPRESS_MAX_KBPS=3000
# COMPRESS_FPS=30
# Upload H.264 recordings as they are (no re-encoding) when at most this many kbps. 0 = always compress.
# COMPRESS_SKIP_BELOW_KBPS=0

# Storage & FFmpeg Paths
LOCAL_RECORDINGS_DIR="./recordings"
FFMPEG_PATH="ffmpeg"

# Crash safety
# Video is saved in pieces of this many seconds (a power cut loses at most the last piece)
SEGMENT_SECONDS=60
# Recording stops by itself after this many minutes
MAX_RECORDING_MINUTES=30
# Refuse to start when free disk space is below this many MB
MIN_FREE_DISK_MB=1024

# Websites allowed to use this agent's local control port (comma separated)
ALLOWED_ORIGINS=http://localhost:3000

# Testing aid: keep a copy of each uploaded video in recordings/kept (default false)
# KEEP_LOCAL_COPIES=true

# Live preview smoothness on the dashboard (pictures per second, width in pixels)
# PREVIEW_FPS=25
# PREVIEW_WIDTH=640

# A recording nobody reviews is saved untrimmed after this many minutes
# REVIEW_TIMEOUT_MINUTES=15

# Make each finished video about 5 times smaller before upload (set COMPRESS_UPLOAD=false to upload as recorded).
# COMPRESS_UPLOAD=true
# COMPRESS_CRF=28
# COMPRESS_FPS=15
# COMPRESS_MAX_HEIGHT=1080
# COMPRESS_MAX_KBPS=1000   (0 = no ceiling)
# COMPRESS_PRESET=medium
# COMPRESS_THREADS=2
