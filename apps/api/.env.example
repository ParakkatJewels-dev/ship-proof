# ShipProof API Configuration
# Copy this file to .env and fill in the values. .env is git-ignored; never commit real secrets.
PORT=4000
NODE_ENV=development
# Without a Supabase project, sign in with this development account (never available in production).
# DEV_LOGIN_EMAIL=admin@shipproof.test
# DEV_LOGIN_PASSWORD=ShipProof#123
JWT_SECRET=super-secret-shipproof-jwt-key-change-in-production

# Public address of the web app. Customer watch links in Shopify are built from it, so in production it must
# be the real https:// address (for example https://proof.yourstore.com).
PUBLIC_WEB_URL=http://localhost:3000
# Websites allowed to call this API from a browser, comma separated. In production, only the real web address.
WEB_ORIGINS=http://localhost:3000

# Secret the camera stations send with every request. Use a long random value and put the same value in
# apps/camera-agent/.env as STATION_API_KEY. Required in production.
STATION_API_KEY=

# ffmpeg on the machine that runs this API. Needed to trim videos that are stored in the cloud.
FFMPEG_PATH=ffmpeg

# Public HTTPS address of this API. Only needed to register Shopify webhooks.
# For local testing, use a tunnel, for example: cloudflared tunnel --url http://localhost:4000
API_PUBLIC_URL=

# Supabase Credentials
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
# The public key (Project settings > API Keys > Publishable key). Used only for signing people in.
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_STORAGE_BUCKET=packing-videos

# Shopify
# The store's *.myshopify.com domain, not the custom storefront domain.
SHOPIFY_SHOP_DOMAIN=666ef0-2.myshopify.com
SHOPIFY_API_VERSION=2026-10

# Dev Dashboard app credentials (Settings > Apps > Develop apps > Build apps in Dev Dashboard).
# The API exchanges these for a 24-hour access token automatically.
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=

# Only for an existing legacy custom app created in the Shopify admin (token starts with shpat_).
# Leave empty when using the client ID and secret above.
SHOPIFY_ADMIN_ACCESS_TOKEN=

# Optional. Defaults to SHOPIFY_CLIENT_SECRET, which is what Dev Dashboard apps sign webhooks with.
SHOPIFY_WEBHOOK_SECRET=

# Retention Policy
# How long a video is kept: 30 days after delivery, 60 days after a return to origin (RTO).
# The database (table retention_policy) holds the numbers that actually decide; change them there.
VIDEO_RETENTION_DAYS=30
RTO_RETENTION_DAYS=60
# Shopify has no RTO status. An order counts as returned when it has any of these tags (comma separated,
# not case sensitive, whole tag only). The 60 days start when the tag first appears.
RTO_TAGS=RTO,RTO Initiated via Shiprocket
