# URL of the ShipProof API (apps/api)
NEXT_PUBLIC_API_URL=http://localhost:4000

# Address the web server uses to reach the API from inside a private network. Optional; defaults to NEXT_PUBLIC_API_URL.
# API_INTERNAL_URL=http://api:4000

# Live "new order" signals (Supabase Realtime). The public project URL and publishable key; leave empty for local demo mode.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
